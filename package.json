{
  "name": "lentz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small, persistent browser workspace for pi and your files.",
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:pi": "tsx tests/real-pi.ts",
    "test:docker": "node tests/docker-smoke.mjs",
    "format": "prettier --write src server shared tests *.ts *.json index.html README.md",
    "bench:history": "tsx tests/benchmark-history.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@fastify/static": "^10.1.10",
    "@uiw/react-codemirror": "^4.25.12",
    "dockview-react": "^8.9.0",
    "fastify": "^5.12.8",
    "lucide-react": "^1.71.0",
    "mime-types": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.0.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
